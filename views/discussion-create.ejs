<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Yeni Tartışma — SoftCampus</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>

<%- include('partials/navbar') %>

<div class="container" style="padding-top:2rem; padding-bottom:2rem; max-width:700px;">
  <div style="background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius-lg); padding:2rem;">

    <h2 style="font-size:1.3rem; font-weight:700; margin-bottom:1.5rem;">💬 Yeni Tartışma Oluştur</h2>

    <form action="/discussions/create" method="POST">

      <div class="sc-form-group">
        <label class="sc-label">Başlık</label>
        <input type="text" name="title" class="sc-form-control" placeholder="Sorunuz veya konunuz nedir?" required/>
      </div>

      <div class="sc-form-group">
        <label class="sc-label">Kategori</label>
        <select name="category" class="sc-form-control">
          <option value="Backend">Backend</option>
          <option value="Frontend">Frontend</option>
          <option value="Career">Kariyer</option>
          <option value="Internship">Staj</option>
          <option value="University Life">Üniversite Hayatı</option>
          <option value="Algorithms">Algoritmalar</option>
          <option value="General">Genel Tartışma</option>
        </select>
      </div>

      <div class="sc-form-group">
        <label class="sc-label">İçerik</label>
        <textarea name="content" class="sc-form-control" rows="6" placeholder="Sorunuzu veya konunuzu detaylı açıklayın..." required></textarea>
      </div>

      <!-- Anonim paylaşım seçeneği -->
      <div class="sc-form-group">
        <div style="display:flex; align-items:center; gap:12px; background:var(--bg-input); border:1px solid var(--border); border-radius:var(--radius-md); padding:12px 16px;">
          <input type="checkbox" id="anonToggle" name="is_anonymous" value="1" style="width:18px; height:18px; cursor:pointer; accent-color:var(--accent-purple);"/>
          <div>
            <label for="anonToggle" style="font-size:0.875rem; font-weight:600; color:var(--text-primary); cursor:pointer;">Anonim Paylaş</label>
            <p style="font-size:0.75rem; color:var(--text-muted); margin-top:2px;">Kullanıcı adınız diğer öğrencilerden gizlenir</p>
          </div>
          <span class="anon-badge ms-auto">👤 Anonim</span>
        </div>
      </div>

      <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn-sc-primary">Konuyu Paylaş</button>
        <a href="/discussions"><button type="button" class="btn-sc-ghost">İptal</button></a>
      </div>

      <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>

    </form>
  </div>
</div>

<%- include('partials/footer') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>