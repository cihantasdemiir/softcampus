<!DOCTYPE html>
<html lang="tr">

<head>
   <meta charset="UTF-8" />
   <meta name="viewport" content="width=device-width, initial-scale=1.0" />
   <title>Admin Panel — SoftCampus</title>
   <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
   <link rel="stylesheet" href="/css/style.css" />
   <style>
      .admin-layout {
         display: flex;
         min-height: calc(100vh - var(--navbar-height));
      }

      .section-panel {
         display: none;
      }

      .section-panel.active {
         display: block;
      }
   </style>
</head>

<body>

   <%- include('../partials/navbar') %>

      <div class="admin-layout">

         <!-- SIDEBAR -->
         <div class="admin-sidebar">
            <div style="padding:0 1.5rem 1rem; border-bottom:1px solid var(--border); margin-bottom:0.5rem;">
               <p
                  style="font-family:var(--font-mono); font-size:0.68rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--text-muted);">
                  Navigasyon</p>
            </div>
            <a class="admin-nav-item active" id="nav-overview" onclick="showSection('overview', this)">
               <span>📊</span> Genel Bakış
            </a>
            <a class="admin-nav-item" id="nav-announcements" onclick="showSection('announcements', this)">
               <span>📢</span> Duyurular
            </a>
            <a class="admin-nav-item" id="nav-discussions" onclick="showSection('discussions', this)">
               <span>💬</span> Tartışmalar
            </a>
            <a class="admin-nav-item" id="nav-users" onclick="showSection('users', this)">
               <span>👥</span> Kullanıcılar
            </a>
            <div style="padding:0 1.5rem; margin-top:1.5rem; border-top:1px solid var(--border); padding-top:1rem;">
               <p
                  style="font-family:var(--font-mono); font-size:0.68rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--text-muted); margin-bottom:0.5rem;">
                  Sistem</p>
               <a class="admin-nav-item" style="padding-left:1.5rem;">
                  <span>⚙️</span> Ayarlar
               </a>
            </div>
         </div>

         <!-- CONTENT -->
         <div class="admin-content">

            <!-- GENEL BAKIŞ -->
            <div class="section-panel active" id="section-overview">
               <div class="d-flex align-items-center justify-content-between mb-4">
                  <div>
                     <h2 style="font-size:1.3rem; font-weight:700;">Genel Bakış</h2>
                     <p style="font-size:0.82rem; color:var(--text-muted); font-family:var(--font-mono);">
                        Hoş geldin, <%= session.fullname %>
                     </p>
                  </div>
               </div>

               <!-- İstatistik kartları - DB'den gelen veriler -->
               <div class="row g-3 mb-4">
                  <div class="col-sm-6 col-xl-3">
                     <div class="admin-stat-card">
                        <div class="admin-stat-icon" style="background:var(--accent-teal-dim);">📢</div>
                        <div>
                           <!-- Duyuru sayısını DB'den al -->
                           <p
                              style="font-size:1.5rem; font-weight:700; font-family:var(--font-mono); color:var(--accent-teal); line-height:1;">
                              <%= stats.announcements %>
                           </p>
                           <p style="font-size:0.75rem; color:var(--text-muted);">Toplam Duyuru</p>
                        </div>
                     </div>
                  </div>
                  <div class="col-sm-6 col-xl-3">
                     <div class="admin-stat-card">
                        <div class="admin-stat-icon" style="background:var(--accent-blue-dim);">👥</div>
                        <div>
                           <p
                              style="font-size:1.5rem; font-weight:700; font-family:var(--font-mono); color:var(--accent-blue); line-height:1;">
                              <%= stats.users %>
                           </p>
                           <p style="font-size:0.75rem; color:var(--text-muted);">Kayıtlı Kullanıcı</p>
                        </div>
                     </div>
                  </div>
                  <div class="col-sm-6 col-xl-3">
                     <div class="admin-stat-card">
                        <div class="admin-stat-icon" style="background:var(--accent-purple-dim);">💬</div>
                        <div>
                           <p
                              style="font-size:1.5rem; font-weight:700; font-family:var(--font-mono); color:var(--accent-purple); line-height:1;">
                              —</p>
                           <p style="font-size:0.75rem; color:var(--text-muted);">Tartışmalar</p>
                        </div>
                     </div>
                  </div>
                  <div class="col-sm-6 col-xl-3">
                     <div class="admin-stat-card">
                        <div class="admin-stat-icon" style="background:var(--accent-green-dim);">✅</div>
                        <div>
                           <p
                              style="font-size:1.5rem; font-weight:700; font-family:var(--font-mono); color:var(--accent-green); line-height:1;">
                              <%= stats.active %>
                           </p>
                           <p style="font-size:0.75rem; color:var(--text-muted);">Aktif Duyuru</p>
                        </div>
                     </div>
                  </div>
               </div>

               <!-- Hızlı işlemler -->
               <div class="row g-3">
                  <div class="col-lg-5">
                     <div
                        style="background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius-lg); padding:1.25rem;">
                        <div class="sc-widget-title mb-3">Hızlı İşlemler</div>
                        <div style="display:flex; flex-direction:column; gap:8px;">
                           <a href="/admin/add/anc">
                              <button class="btn-sc-primary" style="width:100%; justify-content:flex-start;">+ Yeni
                                 Duyuru
                                 Ekle</button>
                           </a>
                           <button class="btn-sc-ghost" style="width:100%; justify-content:flex-start;"
                              onclick="showSection('announcements', document.getElementById('nav-announcements'))">
                              📋 Duyuruları Yönet
                           </button>
                           <button class="btn-sc-ghost" style="width:100%; justify-content:flex-start;"
                              onclick="showSection('users', document.getElementById('nav-users'))">
                              👥 Kullanıcıları Yönet
                           </button>
                        </div>
                     </div>
                  </div>
               </div>
            </div>

            <!-- DUYURULAR BÖLÜMÜ -->
            <div class="section-panel" id="section-announcements">
               <div class="d-flex align-items-center justify-content-between mb-4">
                  <h2 style="font-size:1.3rem; font-weight:700;">Duyuruları Yönet</h2>
                  <a href="/admin/add/anc"><button class="btn-sc-primary">+ Yeni Duyuru</button></a>
               </div>

               <div
                  style="background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius-lg); padding:1.25rem;">
                  <table class="admin-table">
                     <thead>
                        <tr>
                           <th>Başlık</th>
                           <th>Kategori</th>
                           <th>Tarih</th>
                           <th>Durum</th>
                           <th>İşlemler</th>
                        </tr>
                     </thead>
                     <tbody>
                        <% /* DB'den gelen duyuruları tabloda göster */ %>
                           <% announcements.forEach(function(anc) { %>
                              <tr>
                                 <td style="color:var(--text-primary); font-weight:500;">
                                    <%= anc.title %>
                                 </td>
                                 <td><span
                                       class="tag tag-<%= anc.category === 'event' ? 'blue' : anc.category === 'internship' ? 'green' : anc.category === 'workshop' ? 'purple' : anc.category === 'deadline' ? 'amber' : 'teal' %>">
                                       <%= anc.category %>
                                    </span></td>
                                 <td><span class="date-chip">
                                       <%= new Date(anc.created_at).toLocaleDateString('tr-TR') %>
                                    </span></td>
                                 <td>
                                    <% if (anc.is_active) { %>
                                       <span class="tag tag-green">Aktif</span>
                                       <% } else { %>
                                          <span class="tag tag-gray">Pasif</span>
                                          <% } %>
                                 </td>
                                 <td>
                                    <div class="d-flex gap-1">
                                       <a href="/admin/edit/anc/<%= anc.id %>">
                                          <button class="btn-sc-ghost"
                                             style="font-size:0.75rem; padding:4px 10px;">Düzenle</button>
                                       </a>
                                       <a href="/admin/delete/anc/<%= anc.id %>"
                                          onclick="return confirm('Silmek istediğinize emin misiniz?')">
                                          <button class="btn-sc-danger"
                                             style="font-size:0.75rem; padding:4px 10px;">Sil</button>
                                       </a>
                                    </div>
                                 </td>
                              </tr>
                              <% }); %>
                     </tbody>
                  </table>
               </div>
            </div>

            <!-- TARTIŞMALAR BÖLÜMÜ -->
            <div class="section-panel" id="section-discussions">
               <div class="d-flex align-items-center justify-content-between mb-4">
                  <h2 style="font-size:1.3rem; font-weight:700;">Tartışmaları Yönet</h2>
               </div>

               <div
                  style="background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius-lg); padding:1.25rem;">
                  <table class="admin-table">
                     <thead>
                        <tr>
                           <th>Başlık</th>
                           <th>Kategori</th>
                           <th>Tarih</th>
                           <th>Durum</th>
                           <th>İşlemler</th>
                        </tr>
                     </thead>
                     <tbody>
                        <% discussions.forEach(function(disc) { %>
                           <tr>
                              <td style="color:var(--text-primary); font-weight:500;">
                                 <a href="/discussions/<%= disc.slug %>"
                                    style="color:var(--text-primary); text-decoration:none;">
                                    <%= disc.title %>
                                 </a>
                              </td>
                              <td><span class="tag tag-blue">
                                    <%= disc.category %>
                                 </span></td>
                              <td><span class="date-chip">
                                    <%= new Date(disc.created_at).toLocaleDateString('tr-TR') %>
                                 </span></td>
                              <td>
                                 <% if (disc.is_pinned) { %>
                                    <span class="tag tag-amber">📌 Sabitlenmiş</span>
                                    <% } else { %>
                                       <span class="tag tag-gray">Normal</span>
                                       <% } %>
                              </td>
                              <td>
                                 <div class="d-flex gap-1">
                                    <a href="/discussions/pin/<%= disc.id %>">
                                       <button class="btn-sc-ghost" style="font-size:0.75rem; padding:4px 10px;">
                                          <%= disc.is_pinned ? '📌 Sabiti Kaldır' : '📌 Sabitle' %>
                                       </button>
                                    </a>
                                    <a href="/discussions/delete/<%= disc.id %>"
                                       onclick="return confirm('Silmek istediğinize emin misiniz?')">
                                       <button class="btn-sc-danger"
                                          style="font-size:0.75rem; padding:4px 10px;">Sil</button>
                                    </a>
                                 </div>
                              </td>
                           </tr>
                           <% }); %>
                     </tbody>
                  </table>
               </div>
            </div>

            <!-- KULLANICILAR BÖLÜMÜ -->
            <div class="section-panel" id="section-users">
               <div class="d-flex align-items-center justify-content-between mb-4">
                  <h2 style="font-size:1.3rem; font-weight:700;">Kullanıcıları Yönet</h2>
               </div>

               <div
                  style="background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius-lg); padding:1.25rem;">
                  <table class="admin-table">
                     <thead>
                        <tr>
                           <th>Kullanıcı</th>
                           <th>Email</th>
                           <th>Rol</th>
                           <th>Kayıt Tarihi</th>
                           <th>İşlemler</th>
                        </tr>
                     </thead>
                     <tbody>
                        <% /* DB'den gelen kullanıcıları tabloda göster */ %>
                           <% users.forEach(function(user) { %>
                              <tr>
                                 <td>
                                    <div style="display:flex; align-items:center; gap:8px;">
                                       <div
                                          style="width:30px; height:30px; background:var(--accent-blue-dim); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:0.8rem; color:var(--accent-blue); font-weight:700; flex-shrink:0;">
                                          <!-- İsmin baş harflerini göster -->
                                          <%= user.fullname.split(' ').map(n => n[0]).join('').toUpperCase() %>
                  </div>
                  <p style="font-size:0.85rem; font-weight:600; color:var(--text-primary);"><%= user.fullname %></p>
                </div>
              </td>
              <td><span style="font-family:var(--font-mono); font-size:0.78rem; color:var(--text-muted);"><%= user.email %></span></td>
              <td><span class="tag tag-<%= user.role === ' admin' ? 'red' : 'blue' %>"><%= user.role %></span>
                                 </td>
                                 <td><span class="date-chip">
                                       <%= new Date(user.created_at).toLocaleDateString('tr-TR') %>
                                    </span></td>
                                 <td>
                                    <% if (session.role==='admin' ) { %>
                                       <form action="/admin/user/role/<%= user.id %>" method="POST"
                                          style="display:flex; gap:6px; align-items:center;">
                                          <select name="role" class="sc-form-control"
                                             style="font-size:0.78rem; padding:3px 8px; width:auto;">
                                             <option value="user" <%=user.role==='user' ? 'selected' : '' %>>User
                                             </option>
                                             <option value="moderator" <%=user.role==='moderator' ? 'selected' : '' %>
                                                >Moderator</option>
                                             <option value="admin" <%=user.role==='admin' ? 'selected' : '' %>>Admin
                                             </option>
                                          </select>
                                          <button type="submit" class="btn-sc-ghost"
                                             style="font-size:0.75rem; padding:3px 10px;">Kaydet</button>
                                       </form>
                                       <% } else { %>
                                          <span
                                             class="tag tag-<%= user.role === 'admin' ? 'red' : user.role === 'moderator' ? 'purple' : 'blue' %>">
                                             <%= user.role %>
                                          </span>
                                          <% } %>
                                 </td>
                              </tr>
                              <% }); %>
                     </tbody>
                  </table>
               </div>
            </div>
         </div><!-- /admin-content -->
      </div>


      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
      <script>
         function showSection(id, navEl) {
            document.querySelectorAll('.section-panel').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.admin-nav-item').forEach(n => n.classList.remove('active'));
            document.getElementById('section-' + id).classList.add('active');
            if (navEl) navEl.classList.add('active');
         }
      </script>
      <script src="/js/main.js"></script>
</body>

</html>