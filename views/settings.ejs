<!DOCTYPE html>
<html lang="tr">

<head>
   <meta charset="UTF-8" />
   <meta name="viewport" content="width=device-width, initial-scale=1.0" />
   <title>Ayarlar — SoftCampus</title>
   <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
   <link rel="stylesheet" href="/css/style.css" />
</head>

<body>

   <%- include('partials/navbar') %>

      <div class="container" style="padding-top:2rem; padding-bottom:2rem; max-width:900px;">
         <div class="row g-4">

            <!-- SOL SIDEBAR -->
            <div class="col-lg-3">
               <div class="sc-widget">
                  <div class="sc-widget-title">Ayarlar</div>
                  <div style="display:flex; flex-direction:column; gap:4px;">
                     <a href="/settings"
                        style="display:flex; align-items:center; gap:8px; padding:8px 12px; border-radius:var(--radius-sm); background:var(--accent-blue-dim); color:var(--accent-blue); font-size:0.85rem; font-weight:600; text-decoration:none;">
                        🔒 Şifre Değiştir
                     </a>
                  </div>
               </div>
            </div>

            <!-- SAĞ İÇERİK -->
            <div class="col-lg-9">
               <div
                  style="background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius-lg); padding:2rem;">

                  <h4 style="font-size:1.1rem; font-weight:700; margin-bottom:1.5rem;">🔒 Şifre Değiştir</h4>

                  <% if (message) { %>
                     <% if (message.type==='success' ) { %>
                        <div
                           style="padding:10px 16px; border-radius:var(--radius-md); margin-bottom:1.5rem; background:var(--accent-green-dim); border:1px solid rgba(92,184,92,0.3); color:var(--accent-green);">
                           <%= message.text %>
                        </div>
                        <% } else { %>
                           <div
                              style="padding:10px 16px; border-radius:var(--radius-md); margin-bottom:1.5rem; background:rgba(224,92,107,0.1); border:1px solid rgba(224,92,107,0.3); color:var(--accent-red);">
                              <%= message.text %>
                           </div>
                           <% } %>
                              <% } %>

                                 <form action="/settings/change-password" method="POST">

                                    <div class="sc-form-group">
                                       <label class="sc-label">Mevcut Şifre</label>
                                       <div style="position:relative;">
                                          <input type="password" id="currentPassword" name="currentPassword"
                                             class="sc-form-control" placeholder="Mevcut şifreniz" required />
                                          <button type="button" onclick="togglePass('currentPassword')"
                                             style="position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; color:var(--text-muted); cursor:pointer;">👁</button>
                                       </div>
                                    </div>

                                    <div class="sc-form-group">
                                       <label class="sc-label">Yeni Şifre</label>
                                       <div style="position:relative;">
                                          <input type="password" id="newPassword" name="newPassword"
                                             class="sc-form-control" placeholder="Yeni şifreniz" required />
                                          <button type="button" onclick="togglePass('newPassword')"
                                             style="position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; color:var(--text-muted); cursor:pointer;">👁</button>
                                       </div>
                                    </div>

                                    <div class="sc-form-group">
                                       <label class="sc-label">Yeni Şifre Tekrar</label>
                                       <div style="position:relative;">
                                          <input type="password" id="confirmPassword" name="confirmPassword"
                                             class="sc-form-control" placeholder="Yeni şifrenizi tekrar girin"
                                             required />
                                          <button type="button" onclick="togglePass('confirmPassword')"
                                             style="position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; color:var(--text-muted); cursor:pointer;">👁</button>
                                       </div>
                                    </div>

                                    <button type="submit" class="btn-sc-primary">Şifreyi Güncelle</button>
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
                                 </form>
               </div>
            </div>

         </div>
      </div>
      <div style="min-height: 25vh;"></div>
      <%- include('partials/footer') %>

         <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
         <script src="/js/main.js"></script>
         <script>
            function togglePass(id) {
               const el = document.getElementById(id);
               el.type = el.type === 'password' ? 'text' : 'password';
            }
         </script>
</body>

</html>