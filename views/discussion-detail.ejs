<!DOCTYPE html>
<html lang="tr">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= discussion.title %> — SoftCampus
  </title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
  <style>
    .reply-thread {
      border-left: 2px solid var(--border);
      padding-left: 1.25rem;
      margin-left: 1.5rem;
      margin-top: 0.5rem;
    }

    .comment-card {
      padding: 1rem;
      background: var(--bg-elevated);
      border-radius: var(--radius-md);
      border: 1px solid var(--border);
      margin-bottom: 0.5rem;
    }

    .comment-card:hover {
      border-color: var(--border-active);
    }

    .reply-form {
      display: none;
      margin-top: 0.5rem;
    }
  </style>
</head>

<body>

  <%- include('partials/navbar') %>

    <div class="container" style="padding-top:2rem; padding-bottom:2rem; max-width:900px;">

      <!-- Breadcrumb -->
      <div
        style="display:flex; align-items:center; gap:6px; font-size:0.78rem; color:var(--text-muted); margin-bottom:1.5rem; font-family:var(--font-mono);">
        <a href="/" style="color:var(--text-muted);">Ana Sayfa</a><span>/</span>
        <a href="/discussions" style="color:var(--text-muted);">Tartışmalar</a><span>/</span>
        <span style="color:var(--accent-blue);">
          <%= discussion.category %>
        </span>
      </div>

      <!-- ANA GÖNDERI -->
      <div
        style="background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius-lg); padding:1.5rem; margin-bottom:1.5rem;">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:0.75rem;">
          <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
            <span
              class="tag tag-<%= discussion.category === 'Backend' ? 'blue' : discussion.category === 'Frontend' ? 'amber' : discussion.category === 'Career' ? 'purple' : discussion.category === 'Internship' ? 'green' : discussion.category === 'Algorithms' ? 'teal' : 'gray' %>">
              <%= discussion.category %>
            </span>
            <% if (discussion.is_anonymous) { %>
              <% if (canSeeAnonymous) { %>
                <span class="anon-badge">👤 Anonim</span>
                <span style="font-size:0.75rem; color:var(--accent-amber); font-family:var(--font-mono);">(Gerçek: <%=
                    displayName %>)</span>
                <% } else { %>
                  <span class="anon-badge">👤 Anonim</span>
                  <% } %>
                    <% } else { %>
                      <span style="font-size:0.78rem; color:var(--text-muted); font-family:var(--font-mono);">
                        <%= displayName %>
                      </span>
                      <% } %>
                        <span class="date-chip">
                          <%= new Date(discussion.created_at).toLocaleDateString('tr-TR') %>
                        </span>
          </div>

          <!-- Sağ üst: admin işlemleri -->
          <% if (locals.session && (session.role==='admin' || session.role==='moderator' )) { %>
            <div style="display:flex; gap:8px;">
              <a href="/discussions/pin/<%= discussion.id %>" style="font-size:0.75rem; color:var(--accent-amber);">
                <%= discussion.is_pinned ? '📌 Sabiti Kaldır' : '📌 Sabitle' %>
              </a>
              <a href="/discussions/delete/<%= discussion.id %>"
                onclick="return confirm('Bu tartışmayı silmek istediğinize emin misiniz?')"
                style="font-size:0.75rem; color:var(--accent-red);">🗑 Sil</a>
            </div>
            <% } %>
        </div>

        <h1 style="font-size:1.3rem; font-weight:700; letter-spacing:-0.02em; margin-bottom:1rem;">
          <%= discussion.title %>
        </h1>

        <div style="color:var(--text-secondary); font-size:0.9rem; line-height:1.8; margin-bottom:1rem;">
          <%- discussion.content %>
        </div>

        <!-- Like/dislike ve istatistikler -->
        <div
          style="display:flex; align-items:center; justify-content:space-between; padding-top:1rem; border-top:1px solid var(--border);">
          <span style="font-family:var(--font-mono); font-size:0.75rem; color:var(--text-muted);">
            👁 <%= discussion.views %> görüntüleme · 💬 <%= comments.length %> yorum
          </span>
          <% if (locals.session && session.isAuth) { %>
            <div style="display:flex; gap:6px;">
              <form action="/discussions/vote/<%= discussion.id %>" method="POST" style="display:inline;">
                <input type="hidden" name="vote" value="1" />
                <button type="submit"
                  style="background:none; border:1px solid var(--border); border-radius:var(--radius-sm); padding:4px 10px; cursor:pointer; color:var(--accent-green); font-size:0.82rem;">
                  👍 <%= discussion.likes %>
                </button>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
              </form>
              <form action="/discussions/vote/<%= discussion.id %>" method="POST" style="display:inline;">
                <input type="hidden" name="vote" value="-1" />
                <button type="submit"
                  style="background:none; border:1px solid var(--border); border-radius:var(--radius-sm); padding:4px 10px; cursor:pointer; color:var(--accent-red); font-size:0.82rem;">
                  👎 <%= discussion.dislikes %>
                </button>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
              </form>
            </div>
            <% } else { %>
              <span style="font-size:0.82rem; color:var(--text-muted);">👍 <%= discussion.likes %> · 👎 <%=
                    discussion.dislikes %></span>
              <% } %>
        </div>
      </div>

      <!-- YORUMLAR -->
      <div class="sc-section-label mb-3">💬 <%= comments.length %> Yorum</div>

      <% comments.forEach(function(comment) { %>
        <div class="comment-card">
          <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:0.5rem;">
            <div style="display:flex; align-items:center; gap:8px;">
              <div
                style="width:26px; height:26px; background:var(--accent-blue-dim); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:0.7rem; color:var(--accent-blue); font-weight:700;">
                <% if (comment.is_anonymous) { %>?<% } else { %>
                    <%= comment.fullname ? comment.fullname[0].toUpperCase() : '?' %>
                      <% } %>
              </div>
              <% if (comment.is_anonymous) { %>
                <% if (canSeeAnonymous) { %>
                  <span class="anon-badge">👤 Anonim</span>
                  <span style="font-size:0.72rem; color:var(--accent-amber); font-family:var(--font-mono);">(Gerçek: <%=
                      comment.fullname %>)</span>
                  <% } else { %>
                    <span class="anon-badge">👤 Anonim</span>
                    <% } %>
                      <% } else { %>
                        <span style="font-size:0.82rem; font-weight:600; color:var(--text-primary);">
                          <%= comment.fullname %>
                        </span>
                        <% } %>
                          <span class="date-chip">
                            <%= new Date(comment.created_at).toLocaleDateString('tr-TR') %>
                          </span>
            </div>
            <!-- Sil butonu -->
            <% if (locals.session && (session.role==='admin' || session.role==='moderator' )) { %>
              <a href="/comments/delete/<%= comment.id %>"
                onclick="return confirm('Yorumu silmek istediğinize emin misiniz?')"
                style="font-size:0.72rem; color:var(--accent-red);">🗑</a>
              <% } %>
          </div>

          <p style="font-size:0.88rem; color:var(--text-secondary); line-height:1.7; margin-bottom:0.75rem;">
            <%= comment.content %>
          </p>

          <!-- Like/dislike + yanıtla -->
          <div style="display:flex; align-items:center; justify-content:space-between;">
            <% if (locals.session && session.isAuth) { %>
              <div style="display:flex; gap:6px;">
                <form action="/comments/vote/<%= comment.id %>" method="POST" style="display:inline;">
                  <input type="hidden" name="vote" value="1" />
                  <button type="submit"
                    style="background:none; border:1px solid var(--border); border-radius:var(--radius-sm); padding:2px 8px; cursor:pointer; color:var(--accent-green); font-size:0.78rem;">
                    👍 <%= comment.likes %>
                  </button>
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
                </form>
                <form action="/comments/vote/<%= comment.id %>" method="POST" style="display:inline;">
                  <input type="hidden" name="vote" value="-1" />
                  <button type="submit"
                    style="background:none; border:1px solid var(--border); border-radius:var(--radius-sm); padding:2px 8px; cursor:pointer; color:var(--accent-red); font-size:0.78rem;">
                    👎 <%= comment.dislikes %>
                  </button>
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
                </form>
              </div>
              <button onclick="toggleReplyForm(<%= comment.id %>)"
                style="background:none; border:none; color:var(--accent-blue); font-size:0.78rem; cursor:pointer;">💬
                Yanıtla</button>
              <% } else { %>
                <span style="font-size:0.78rem; color:var(--text-muted);">👍 <%= comment.likes %> · 👎 <%=
                      comment.dislikes %></span>
                <% } %>
          </div>

          <!-- Yanıt formu -->
          <% if (locals.session && session.isAuth) { %>
            <div id="reply-form-<%= comment.id %>" class="reply-form">
              <form action="/comments/add/<%= discussion.id %>" method="POST" style="margin-top:0.75rem;">
                <input type="hidden" name="parent_id" value="<%= comment.id %>" />
                <textarea name="content" class="sc-form-control" rows="2" placeholder="Yanıtınızı yazın..." required
                  style="font-size:0.85rem; margin-bottom:0.5rem;"></textarea>
                <div style="display:flex; align-items:center; gap:10px;">
                  <input type="checkbox" id="anon-reply-<%= comment.id %>" name="is_anonymous" value="1"
                    style="accent-color:var(--accent-purple);" />
                  <label for="anon-reply-<%= comment.id %>" style="font-size:0.78rem; color:var(--text-muted);">Anonim
                    yanıtla</label>
                  <button type="submit" class="btn-sc-primary"
                    style="font-size:0.78rem; padding:4px 12px; margin-left:auto;">Gönder</button>
                </div>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
              </form>
            </div>
            <% } %>

              <!-- Alt yorumlar (replies) -->
              <% const commentReplies=replies.filter(r=> r.parent_id === comment.id); %>
                <% if (commentReplies.length> 0) { %>
                  <div class="reply-thread">
                    <% commentReplies.forEach(function(reply) { %>
                      <div class="comment-card" style="background:var(--bg-card);">
                        <div
                          style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:0.5rem;">
                          <div style="display:flex; align-items:center; gap:8px;">
                            <div
                              style="width:22px; height:22px; background:var(--accent-purple-dim); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:0.65rem; color:var(--accent-purple); font-weight:700;">
                              <% if (reply.is_anonymous) { %>?<% } else { %>
                                  <%= reply.fullname ? reply.fullname[0].toUpperCase() : '?' %>
                                    <% } %>
                            </div>
                            <% if (reply.is_anonymous) { %>
                              <% if (canSeeAnonymous) { %>
                                <span class="anon-badge">👤 Anonim</span>
                                <span
                                  style="font-size:0.72rem; color:var(--accent-amber); font-family:var(--font-mono);">(Gerçek:
                                  <%= reply.fullname %>)</span>
                                <% } else { %>
                                  <span class="anon-badge">👤 Anonim</span>
                                  <% } %>
                                    <% } else { %>
                                      <span style="font-size:0.8rem; font-weight:600; color:var(--text-primary);">
                                        <%= reply.fullname %>
                                      </span>
                                      <% } %>
                                        <span class="date-chip">
                                          <%= new Date(reply.created_at).toLocaleDateString('tr-TR') %>
                                        </span>
                          </div>
                          <% if (locals.session && (session.role==='admin' || session.role==='moderator' )) { %>
                            <a href="/comments/delete/<%= reply.id %>"
                              onclick="return confirm('Yanıtı silmek istediğinize emin misiniz?')"
                              style="font-size:0.72rem; color:var(--accent-red);">🗑</a>
                            <% } %>
                        </div>
                        <p
                          style="font-size:0.85rem; color:var(--text-secondary); line-height:1.7; margin-bottom:0.5rem;">
                          <%= reply.content %>
                        </p>
                        <div style="display:flex; gap:6px;">
                          <% if (locals.session && session.isAuth) { %>
                            <form action="/comments/vote/<%= reply.id %>" method="POST" style="display:inline;">
                              <input type="hidden" name="vote" value="1" />
                              <button type="submit"
                                style="background:none; border:1px solid var(--border); border-radius:var(--radius-sm); padding:2px 8px; cursor:pointer; color:var(--accent-green); font-size:0.75rem;">
                                👍 <%= reply.likes %>
                              </button>
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
                            </form>
                            <form action="/comments/vote/<%= reply.id %>" method="POST" style="display:inline;">
                              <input type="hidden" name="vote" value="-1" />
                              <button type="submit"
                                style="background:none; border:1px solid var(--border); border-radius:var(--radius-sm); padding:2px 8px; cursor:pointer; color:var(--accent-red); font-size:0.75rem;">
                                👎 <%= reply.dislikes %>
                              </button>
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
                            </form>
                            <% } else { %>
                              <span style="font-size:0.75rem; color:var(--text-muted);">👍 <%= reply.likes %> · 👎 <%=
                                    reply.dislikes %></span>
                              <% } %>
                        </div>
                      </div>
                      <% }); %>
                  </div>
                  <% } %>
        </div>
        <% }); %>

          <!-- ANA YORUM KUTUSU -->
          <div
            style="background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius-lg); padding:1.5rem; margin-top:1.5rem;">
            <div class="sc-section-label mb-3">Yanıt Yaz</div>

            <% if (locals.session && session.isAuth) { %>
              <form action="/comments/add/<%= discussion.id %>" method="POST">
                <textarea name="content" class="sc-form-control" rows="4" placeholder="Düşüncelerinizi paylaşın..."
                  required style="margin-bottom:0.75rem;"></textarea>
                <div
                  style="display:flex; align-items:center; gap:12px; background:var(--bg-input); border:1px solid var(--border); border-radius:var(--radius-md); padding:10px 14px; margin-bottom:0.75rem;">
                  <input type="checkbox" id="anonComment" name="is_anonymous" value="1"
                    style="width:16px; height:16px; accent-color:var(--accent-purple);" />
                  <label for="anonComment"
                    style="font-size:0.82rem; color:var(--text-secondary); cursor:pointer;">Anonim olarak
                    yanıtla</label>
                </div>
                <button type="submit" class="btn-sc-primary">Yanıt Gönder</button>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
              </form>
              <% } else { %>
                <div
                  style="background:var(--bg-input); border:1px solid var(--border); border-radius:var(--radius-md); padding:12px;">
                  <p style="font-size:0.82rem; color:var(--text-muted);">
                    ⚠️ Yanıt yazabilmek için <a href="/auth/login" style="color:var(--accent-blue);">giriş yapın</a>.
                  </p>
                </div>
                <% } %>
          </div>

    </div>

    <%- include('partials/footer') %>

      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
      <script src="/js/main.js"></script>
      <script>
        function toggleReplyForm(commentId) {
          const form = document.getElementById('reply-form-' + commentId);
          form.style.display = form.style.display === 'none' ? 'block' : 'none';
        }
      </script>
</body>

</html>