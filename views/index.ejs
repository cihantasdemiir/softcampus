<!DOCTYPE html>
<html lang="tr">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SoftCampus — Yazılım Mühendisliği</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body>

  <%- include('partials/navbar') %>

    <!-- HERO STRIP -->
    <div class="sc-hero-strip">
      <div class="container">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
          <div>
            <div class="d-flex align-items-center gap-2 mb-1">
              <span class="online-dot"></span>
              <span
                style="font-family:var(--font-mono); font-size:0.72rem; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.08em;">Canlı
                feed</span>
            </div>
            <h1 style="font-size:1.5rem; font-weight:700; letter-spacing:-0.03em;">Duyurular & Güncellemeler</h1>
            <p style="font-size:0.875rem; color:var(--text-secondary); margin-top:4px;">
              Yazılım Mühendisliği öğrencileri için bölüm haberleri, etkinlikler, stajlar ve workshop güncellemeleri.
            </p>
          </div>
          <div class="d-flex align-items-center gap-2">
            <div class="sc-tabs">
              <button class="sc-tab active" onclick="filterAnnouncements('all', this)">Tümü</button>
              <button class="sc-tab" onclick="filterAnnouncements('event', this)">Etkinlikler</button>
              <button class="sc-tab" onclick="filterAnnouncements('internship', this)">Stajlar</button>
              <button class="sc-tab" onclick="filterAnnouncements('workshop', this)">Workshop</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="container" style="padding-top:2rem; padding-bottom:2rem;">
      <div class="row g-4">

        <!-- FEED -->
        <div class="col-lg-8">

          <div class="sc-section-label mb-3">Son Duyurular</div>

          <div id="announcements-feed">

            <% if (data.length===0) { %>
              <p class="text-muted">Henüz duyuru yok.</p>
              <% } %>

                <% /* Veritabanından gelen her duyuru için kart oluştur */ %>
                  <% data.forEach(function(anc) { %>
                    <% if (anc.is_active) { %>
                      <div class="sc-card announcement-card type-<%= anc.category %> sc-card-clickable"
                        data-type="<%= anc.category %>">
                        <div class="card-type-indicator"></div>
                        <div style="padding-left:0.5rem;">
                          <div class="announcement-meta">
                             <% if (anc.is_pinned) { %><span class="pinned-dot"></span><span class="tag tag-amber">📌 Sabitlenmiş</span><% } %>
                            <span
                              class="tag tag-<%= anc.category === 'event' ? 'blue' : anc.category === 'internship' ? 'green' : anc.category === 'workshop' ? 'purple' : anc.category === 'deadline' ? 'amber' : 'teal' %>">
                              <%= anc.category==='event' ? '📅 Etkinlik' : anc.category==='internship' ? '💼 Staj' :
                                anc.category==='workshop' ? '🛠 Workshop' : anc.category==='deadline' ? '⚠️ Son Tarih'
                                : '📢 Haber' %>
                            </span>
                            <span class="date-chip">
                              <%= new Date(anc.created_at).toLocaleDateString('tr-TR') %>
                            </span>
                          </div>
                          <h3 class="announcement-title">
                            <%= anc.title %>
                          </h3>
                          <% if (anc.content && anc.content.length> 0) { %>
                            <p class="announcement-excerpt">
                              <%= anc.content.substring(0, 180) %>
                                <%= anc.content.length> 180 ? '...' : '' %>
                            </p>
                            <% } %>
                              <div class="announcement-footer">
                                <span></span>
                                <a href="/announcements/<%= anc.slug %>">
                                  <button class="btn-sc-ghost" style="font-size:0.78rem;">Detayı Gör →</button>
                                </a>
                              </div>
                        </div>
                      </div>
                      <% } %>
                        <% }); %>

          </div><!-- /feed -->
        </div><!-- /col -->

        <!-- SIDEBAR -->
        <div class="col-lg-4">

          <!-- Platform İstatistikleri -->
          <div class="sc-widget">
            <div class="sc-widget-title">Platform İstatistikleri</div>
            <div class="quick-stat">
              <span>📢 Duyurular</span>
              <span class="quick-stat-val">
                <%= data.length %>
              </span>
            </div>
            <div class="quick-stat">
              <span>💬 Tartışmalar</span>
              <span class="quick-stat-val">—</span>
            </div>
            <div class="quick-stat">
              <span>🖼 Galeri</span>
              <span class="quick-stat-val">—</span>
            </div>
          </div>

          <!-- Hızlı Linkler -->
          <div class="sc-widget">
            <div class="sc-widget-title">Hızlı Linkler</div>
            <div style="display:flex; flex-direction:column; gap:6px;">
              <a href="#"
                style="display:flex; align-items:center; gap:8px; padding:8px; border-radius:var(--radius-sm); color:var(--text-secondary); font-size:0.85rem; transition:all .15s;"
                onmouseover="this.style.background='var(--bg-elevated)';this.style.color='var(--text-primary)'"
                onmouseout="this.style.background='transparent';this.style.color='var(--text-secondary)'">
                📚 Akademik Takvim
              </a>
              <a href="#"
                style="display:flex; align-items:center; gap:8px; padding:8px; border-radius:var(--radius-sm); color:var(--text-secondary); font-size:0.85rem; transition:all .15s;"
                onmouseover="this.style.background='var(--bg-elevated)';this.style.color='var(--text-primary)'"
                onmouseout="this.style.background='transparent';this.style.color='var(--text-secondary)'">
                🎓 Ders Kataloğu
              </a>
              <a href="#"
                style="display:flex; align-items:center; gap:8px; padding:8px; border-radius:var(--radius-sm); color:var(--text-secondary); font-size:0.85rem; transition:all .15s;"
                onmouseover="this.style.background='var(--bg-elevated)';this.style.color='var(--text-primary)'"
                onmouseout="this.style.background='transparent';this.style.color='var(--text-secondary)'">
                📝 Öğrenci Portalı
              </a>
              <a href="#"
                style="display:flex; align-items:center; gap:8px; padding:8px; border-radius:var(--radius-sm); color:var(--text-secondary); font-size:0.85rem; transition:all .15s;"
                onmouseover="this.style.background='var(--bg-elevated)';this.style.color='var(--text-primary)'"
                onmouseout="this.style.background='transparent';this.style.color='var(--text-secondary)'">
                📖 Kütüphane
              </a>
            </div>
          </div>

          <!-- Admin girişi varsa link göster -->
          <% if (locals.session && session.isAuth && (session.role==='admin' || session.role==='moderator' )) { %>
            <div class="sc-widget">
              <div class="sc-widget-title">Yönetim</div>
              <a href="/admin" class="btn-sc-primary btn w-100 text-center" style="font-size:0.85rem;">Admin Paneli</a>
            </div>
            <% } %>

        </div><!-- /sidebar -->
      </div>
    </div>
    <div style="min-height: 10vh;"></div>
    <%- include('partials/footer') %>

      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
      <script src="/js/main.js"></script>
      <script>
        function filterAnnouncements(type, btn) {
          document.querySelectorAll('.sc-tab').forEach(t => t.classList.remove('active'));
          btn.classList.add('active');
          document.querySelectorAll('#announcements-feed .announcement-card').forEach(card => {
            if (type === 'all' || card.dataset.type === type) {
              card.style.display = '';
            } else {
              card.style.display = 'none';
            }
          });
        }
      </script>
</body>

</html>