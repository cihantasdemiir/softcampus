<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Kayıt Ol — SoftCampus</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>

<nav class="sc-navbar">
  <div class="container-fluid">
    <a class="sc-brand" href="/">
      <div class="sc-brand-icon">SC</div>
      <div><span class="sc-brand-text">SoftCampus</span><span class="sc-brand-sub">Yazılım Mühendisliği</span></div>
    </a>
    <div style="margin-left:auto;">
      <span style="font-size:0.82rem; color:var(--text-muted);">Zaten hesabın var mı?</span>
      <a href="/auth/login"><button class="btn-sc-ghost ms-2" style="font-size:0.82rem;">Giriş Yap</button></a>
    </div>
  </div>
</nav>

<div class="auth-page" style="padding-top:3rem; padding-bottom:3rem; align-items:flex-start;">

  <div style="position:fixed; top:10%; right:10%; width:400px; height:400px; background:radial-gradient(circle, rgba(79,126,247,0.06) 0%, transparent 70%); pointer-events:none;"></div>
  <div style="position:fixed; bottom:15%; left:5%; width:300px; height:300px; background:radial-gradient(circle, rgba(155,125,240,0.05) 0%, transparent 70%); pointer-events:none;"></div>

  <div class="auth-card" style="max-width:520px;">

    <div class="auth-logo">
      <div style="display:inline-flex; align-items:center; justify-content:center; width:52px; height:52px; background:linear-gradient(135deg, var(--accent-blue), var(--accent-purple)); border-radius:var(--radius-md); font-family:var(--font-mono); font-weight:700; font-size:1.2rem; color:#fff; margin-bottom:1rem;">SC</div>
      <h2 style="font-size:1.4rem; font-weight:700; letter-spacing:-0.03em;">SoftCampus'a Katıl</h2>
      <p style="font-size:0.85rem; color:var(--text-secondary); margin-top:4px;">Öğrenci topluluğu hesabını oluştur</p>
    </div>

    <div style="background:var(--accent-purple-dim); border:1px solid rgba(155,125,240,0.2); border-radius:var(--radius-md); padding:10px 14px; margin-bottom:1.5rem; display:flex; align-items:center; gap:10px;">
      <span style="font-size:1rem;">ℹ️</span>
      <p style="font-size:0.75rem; color:var(--text-secondary);">Kayıt için geçerli bir üniversite öğrenci emaili gereklidir.</p>
    </div>

    <form action="/auth/register" method="POST">

      <div class="sc-form-group">
        <label class="sc-label">Ad Soyad</label>
        <input type="text" name="fullname" class="sc-form-control" placeholder="Ahmet Yılmaz" required/>
      </div>

      <div class="sc-form-group">
        <label class="sc-label">Öğrenci Email</label>
        <input type="email" name="email" class="sc-form-control" placeholder="kullanici@std.samsun.edu.tr" required/>
        <p style="font-size:0.72rem; color:var(--text-muted); margin-top:4px; font-family:var(--font-mono);">Üniversite email adresin olmalıdır</p>
      </div>

      <div class="sc-form-group">
        <label class="sc-label">Şifre</label>
        <div style="position:relative;">
          <input type="password" id="regPass" name="password" class="sc-form-control" placeholder="En az 8 karakter" required/>
          <button type="button" onclick="togglePass('regPass')" style="position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; color:var(--text-muted); cursor:pointer;">👁</button>
        </div>
      </div>

      <div class="sc-form-group">
        <div style="display:flex; gap:10px; align-items:flex-start;">
          <input type="checkbox" id="terms" required style="width:16px; height:16px; cursor:pointer; accent-color:var(--accent-blue); margin-top:2px; flex-shrink:0;"/>
          <label for="terms" style="font-size:0.8rem; color:var(--text-secondary); cursor:pointer; line-height:1.5;">
            <a href="#" style="color:var(--accent-blue);">Topluluk Kurallarını</a> ve <a href="#" style="color:var(--accent-blue);">Kullanım Koşullarını</a> kabul ediyorum.
          </label>
        </div>
      </div>

      <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>

      <button type="submit" class="btn-sc-primary" style="width:100%; justify-content:center; padding:11px;">
        Hesap Oluştur →
      </button>

    </form>

    <hr style="border-color:var(--border); margin:1.5rem 0;"/>

    <div style="text-align:center;">
      <p style="font-size:0.82rem; color:var(--text-muted);">
        Zaten hesabın var mı? <a href="/auth/login" style="color:var(--accent-blue); font-weight:600;">Giriş yap</a>
      </p>
    </div>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
function togglePass(id) {
  const el = document.getElementById(id);
  el.type = el.type === 'password' ? 'text' : 'password';
}
</script>
</body>
</html>